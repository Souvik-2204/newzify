# Optional for local development. Without a URL, npm run dev starts real PostgreSQL locally.
DATABASE_URL=postgresql://meridian:replace-me@db.example:5432/meridian?sslmode=require
PORT=5433
# Public HTTPS origin for absolute canonical story URLs (no trailing slash).
PUBLIC_ORIGIN=
# Test credentials only. Live credentials are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Production seed administrator; never committed to the client bundle.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel only: connect a Private Blob store. Never put this token in a VITE_ variable.
# UPLOAD_STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN=
